generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
  OWNER
  USER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum SubscriptionPlan {
  TRIAL
  PRO
  PRO_PLUS
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  VOICE
  VIDEO_NOTE
}

enum DeviceAccountKind {
  OWNER
  USER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  CONNECTING
  STREAMING
  ERROR
}

enum StreamSessionStatus {
  STARTING
  ACTIVE
  ENDED
  FAILED
}

enum NetworkType {
  WIFI
  MOBILE
  UNKNOWN
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum CameraFacing {
  FRONT
  BACK
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordingRetentionDays  Int     @default(7)
  recordingAutoCleanup    Boolean @default(true)
  recordingSegmentSeconds Int     @default(300)

  branches         Branch[]
  users            User[]
  devices          Device[]
  snapshots        Snapshot[]
  auditLogs         AuditLog[]
  streamSessions    StreamSession[]
  recordingSegments RecordingSegment[]
  subscriptions     Subscription[]
  chatThreads       ChatThread[]
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  devices      Device[]
  snapshots    Snapshot[]
  pairingCodes DevicePairingCode[]

  @@index([organizationId])
}

model User {
  id             String    @id @default(cuid())
  email          String
  passwordHash   String
  name           String
  phone          String?
  username       String?
  role           UserRole  @default(ADMIN)
  blocked        Boolean   @default(false)
  organizationId String
  deviceId         String?   @unique
  lastSeenAt       DateTime?
  avatarKey        String?
  avatarUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  snapshots    Snapshot[]
  auditLogs    AuditLog[]
  ownedThreads ChatThread[] @relation("ThreadOwner")
  peerThreads  ChatThread[] @relation("ThreadPeer")
  sentMessages ChatMessage[] @relation("MessageSender")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([role])
}

model Device {
  id               String       @id @default(cuid())
  name             String
  organizationId   String
  branchId         String
  status           DeviceStatus @default(OFFLINE)
  lastSeen         DateTime?
  credentialsHash  String?
  apiKeyHash       String?
  capabilitiesJson Json?
  batteryPercent   Int?
  charging         Boolean?
  batterySaver     Boolean?
  thermalState     String?
  networkType      NetworkType?
  networkQuality   Int?
  errorCode        String?
  errorMessage     String?
  appVersion       String?
  androidVersion   String?
  deviceModel      String?
  disabled         Boolean           @default(false)
  accountKind        DeviceAccountKind @default(USER)
  linkedFromDeviceId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  linkedFromDevice  Device?              @relation("DeviceLink", fields: [linkedFromDeviceId], references: [id], onDelete: SetNull)
  linkedDevices     Device[]             @relation("DeviceLink")
  linkedUser        User?
  pairingCodes      DevicePairingCode[]
  streamSessions    StreamSession[]
  snapshots         Snapshot[]
  recordingSegments RecordingSegment[]
  chatThreads       ChatThread[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model DevicePairingCode {
  id             String    @id @default(cuid())
  code           String    @unique
  organizationId String
  branchId       String
  deviceId       String?
  issuerDeviceId String?
  issuerUserId   String?
  deviceNameHint String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([branchId])
  @@index([issuerDeviceId])
}

model StreamSession {
  id             String              @id @default(cuid())
  deviceId       String
  organizationId String
  status         StreamSessionStatus @default(STARTING)
  quality        String?
  startedAt      DateTime            @default(now())
  endedAt        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([organizationId])
}

model RecordingSegment {
  id             String          @id @default(cuid())
  organizationId String
  deviceId       String
  deviceName     String
  cameraFacing   CameraFacing    @default(BACK)
  quality        String          @default("MEDIUM")
  status         RecordingStatus @default(RECORDING)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  durationSec    Int?
  fileSize       Int             @default(0)
  storagePath    String
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([deviceId, startedAt])
  @@index([organizationId, cameraFacing, startedAt])
  @@index([organizationId, status])
  @@index([status, startedAt])
}

model Snapshot {
  id             String   @id @default(cuid())
  deviceId       String
  organizationId String
  branchId       String
  userId         String
  path           String
  createdAt      DateTime @default(now())

  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  status         SubscriptionStatus @default(PENDING)
  plan           SubscriptionPlan   @default(TRIAL)
  maxDevices     Int                @default(2)
  startedAt      DateTime?
  expiresAt      DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model ChatThread {
  id                  String    @id @default(cuid())
  organizationId      String
  ownerUserId         String
  peerUserId          String
  deviceId            String?
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("ThreadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  peer         User         @relation("ThreadPeer", fields: [peerUserId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@unique([organizationId, ownerUserId, peerUserId])
  @@index([organizationId])
  @@index([deviceId])
}

model ChatMessage {
  id                 String          @id @default(cuid())
  threadId           String
  senderUserId       String?
  receiverUserId     String?
  messageType        ChatMessageType @default(TEXT)
  text               String?
  attachmentUrl      String?
  createdAt          DateTime        @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?
  editedAt           DateTime?
  deletedAt          DateTime?
  deletedForEveryone Boolean         @default(false)
  replyToId          String?
  forwardedFromId    String?
  clientId           String?
  albumId            String?
  fileName           String?
  fileSize           Int?
  mimeType           String?
  durationMs         Int?
  width              Int?
  height             Int?
  storageKey         String?
  thumbnailKey       String?
  waveformJson       String?

  thread           ChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender           User?             @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyTo          ChatMessage?      @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]     @relation("MessageReply")
  forwardedFrom    ChatMessage?      @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedCopies  ChatMessage[]     @relation("MessageForward")
  reactions        ChatReaction[]
  hiddenFor        ChatMessageHide[]

  @@index([threadId, createdAt])
  @@index([threadId, messageType])
  @@index([clientId])
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model ChatMessageHide {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}
